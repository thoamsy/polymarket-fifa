CLOB_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-rpc.com

# Magic/Google Polymarket proxy flow:
# - PRIVATE_KEY is the Magic wallet private key from reveal.magic.link/polymarket.
# - FUNDER_ADDRESS is the Polymarket proxy/profile wallet shown in settings.
# - SIGNATURE_TYPE=1 means POLY_PROXY.
PRIVATE_KEY=0x...
FUNDER_ADDRESS=0xf5302cD6D5e306cBEd6fCe9475e2b86Df890DE13
SIGNATURE_TYPE=1

# Fill these after running: pnpm poly:derive-key
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Hard caps. config/world-cup-group-strategy.json holds the defaults; these env vars
# override them for a single run. The code only enforces these limits — the LLM decides
# which team to back, the price, and the size (authored into runs/latest-plan.json).
STRATEGY_CONFIG=config/world-cup-group-strategy.json
STRATEGY_PLAN_PATH=runs/latest-plan.json
MAX_BET_USDC=2
MAX_RUN_NOTIONAL_USDC=30
MAX_ORDERS_PER_RUN=4

# Fill-watch controls (poly:watch-fills cancels orders unfilled past the timeout).
UNFILLED_CANCEL_SECONDS=300
POLL_INTERVAL_SECONDS=15

# Real order execution is disabled unless this is set to 1 for a single run.
POLY_EXECUTE=0
PLAN_MAX_AGE_SECONDS=600
